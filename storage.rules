rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /media/{fileName} {
      allow read: if true;
      // Solo admin, máx. 60 MB, solo audio o vídeo
      allow create: if request.auth != null
                    && request.resource.size < 60 * 1024 * 1024
                    && request.resource.contentType.matches('(audio|video)/.*');
      allow delete: if request.auth != null;
    }
  }
}
